---
import "../styles/global.css";
import { alternateLinks, localizedPath, siteMeta, type Locale } from "../data/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath?: string;
  alternateUrls?: Array<{ href: string; hreflang: string }>;
  structuredData?: Record<string, unknown> | null;
  faqItems?: Array<{ question: string; answer: string }>;
}

const { locale, title, description, canonicalPath: customCanonicalPath, alternateUrls, structuredData, faqItems } = Astro.props;
const canonicalPath = customCanonicalPath ?? localizedPath(locale);
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? `https://${siteMeta.domain}`;
const canonicalUrl = `${siteOrigin}${canonicalPath}`;
const geoCoordinates = {
  "@type": "GeoCoordinates",
  latitude: -7.4667,
  longitude: -34.8333,
};
const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": ["TouristAttraction", "Place"],
  name: siteMeta.name,
  description,
  url: canonicalUrl,
  image: `${siteOrigin}${siteMeta.ogImage}`,
  sameAs: [siteMeta.mapsUrl],
  address: {
    "@type": "PostalAddress",
    streetAddress: "Unnamed Road",
    addressLocality: "Pitimbu",
    addressRegion: "Paraíba",
    addressCountry: "BR",
    postalCode: "58324-000",
  },
  geo: geoCoordinates,
  isAccessibleForFree: true,
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "00:00",
    closes: "23:59",
  },
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteMeta.name,
  url: `${siteOrigin}/`,
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Brasil" },
    { "@type": "ListItem", position: 2, name: "Paraíba" },
    { "@type": "ListItem", position: 3, name: "Pitimbu" },
    { "@type": "ListItem", position: 4, name: "Praia Bela", item: canonicalUrl },
  ],
};
const faqSchema = faqItems?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    }
  : null;

const pageStructuredData =
  structuredData === undefined
    ? [touristAttractionSchema, webSiteSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]
    : structuredData;
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : locale === "pt" ? "pt-BR" : locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      (alternateUrls ??
        alternateLinks.map((item) => ({
          hreflang: item.locale === "zh" ? "zh-CN" : item.locale === "pt" ? "pt-BR" : item.locale,
          href: `${siteOrigin}${item.href}`,
        }))).map((item) => (
        <link
          rel="alternate"
          hreflang={item.hreflang}
          href={item.href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteOrigin}${siteMeta.ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteOrigin}${siteMeta.ogImage}`} />
    {pageStructuredData && <script type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />}
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
