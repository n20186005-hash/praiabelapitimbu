---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteMeta, type Locale } from "../data/site";
import type { TopicContent } from "../data/topics";

interface Props {
  locale: Locale;
  slug: string;
  topic: TopicContent;
}

const { locale, slug, topic } = Astro.props;
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? `https://${siteMeta.domain}`;
const topicUrl = `${siteOrigin}/pt/${slug}/`;
const homePath = locale === "zh" ? "/" : `/${locale}/`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: topic.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Praia Bela - Pitimbu", item: `${siteOrigin}/pt/` },
    { "@type": "ListItem", position: 2, name: topic.h1, item: topicUrl },
  ],
};
const pageStructuredData = [faqSchema, breadcrumbSchema];
const alternateUrls = [{ hreflang: "pt-BR", href: topicUrl }];
---

<BaseLayout
  locale={locale}
  title={topic.title}
  description={topic.description}
  canonicalPath={`/pt/${slug}/`}
  alternateUrls={alternateUrls}
  structuredData={pageStructuredData}
>
  <div class="min-h-screen">
    <header class="sticky top-0 z-30 border-b border-white/30 bg-[#f7f5ef]/85 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 lg:px-8">
        <a href={homePath} class="text-sm font-semibold tracking-[0.18em] text-slate-700 uppercase">
          {siteMeta.name}
        </a>
        <a
          href={homePath}
          class="rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-500 hover:text-slate-950"
        >
          ← Praia Bela
        </a>
      </div>
    </header>

    <main>
      <section class="relative isolate overflow-hidden bg-slate-950">
        <div class="absolute inset-0 bg-cover bg-center opacity-40" style={`background-image:url(${siteMeta.heroImage});`}></div>
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(7,15,24,0.55),rgba(7,15,24,0.88))]"></div>
        <div class="relative mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
          <p class="mb-4 text-xs font-semibold tracking-[0.18em] text-white/60 uppercase">
            Pitimbu, Paraíba · Brasil
          </p>
          <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-white md:text-5xl">
            {topic.h1}
          </h1>
          <p class="mt-6 max-w-2xl text-base leading-7 text-white/85 md:text-lg">
            {topic.intro}
          </p>
        </div>
      </section>

      <section class="mx-auto max-w-7xl px-5 py-18 lg:px-8">
        <div class="grid gap-6 md:grid-cols-2">
          {
            topic.sections.map((section) => (
              <article class="rounded-[1.75rem] border border-stone-200/80 bg-white/85 p-6 shadow-sm shadow-stone-200/40">
                <h2 class="text-xl font-semibold text-slate-900">{section.title}</h2>
                <p class="mt-4 text-sm leading-7 text-slate-600">{section.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="border-t border-stone-200/70 bg-white/55">
        <div class="mx-auto max-w-7xl px-5 py-18 lg:px-8">
          <h2 class="text-3xl font-semibold tracking-tight text-slate-950">Perguntas frequentes</h2>
          <div class="mt-12 flex flex-col gap-4">
            {
              topic.faq.map((item) => (
                <details class="group rounded-[1.5rem] border border-stone-200/80 bg-white/90 p-6 shadow-sm shadow-stone-200/30">
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left text-lg font-semibold text-slate-900">
                    <span>{item.question}</span>
                    <span class="mt-1 text-slate-400 transition group-open:rotate-45">+</span>
                  </summary>
                  <p class="mt-4 text-sm leading-7 text-slate-600">{item.answer}</p>
                </details>
              ))
            }
          </div>
          <div class="mt-12">
            <a
              href={homePath}
              class="inline-flex rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white hover:bg-slate-700"
            >
              ← Voltar para o guia da Praia Bela
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-stone-200/70 bg-[#f4f1e8]">
      <div class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
        <p class="max-w-2xl text-sm leading-relaxed text-slate-600 font-medium">
          {siteMeta.name} — guia independente e sem fins lucrativos sobre a Praia Bela em Pitimbu, Paraíba.
        </p>
      </div>
    </footer>
  </div>
</BaseLayout>
